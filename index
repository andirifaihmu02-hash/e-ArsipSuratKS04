        function renderChart(smCount, skCount) {
            const chartCanvas = document.getElementById('chart-surat');
            if (!chartCanvas) return;

            try {
                if (typeof window.Chart === 'undefined') {
                    console.warn("Chart.js belum siap/tidak tersedia.");
                    return;
                }

                const ctx = chartCanvas.getContext('2d');
                if (chartInstance) {
                    chartInstance.destroy();
                }

                chartInstance = new window.Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['Surat Masuk', 'Surat Keluar'],
                        datasets: [{
                            label: 'Jumlah Dokumen',
                            data: [smCount, skCount],
                            backgroundColor: ['#6366f1', '#10b981'],
                            borderRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                    }
                });
            } catch (err) {
                console.warn("Chart rendering safely skipped:", err);
            }
        }

