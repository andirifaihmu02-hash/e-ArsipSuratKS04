<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SiSurat - Sistem Informasi Surat Masuk & Surat Keluar</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Chart.js CDN (UMD Bundle) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <!-- Supabase JS Client (UMD Bundle) -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <!-- Manifest Dynamic Data URI for PWA -->
    <link rel="manifest" id="pwa-manifest">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #f6f9fc 0%, #eef2f7 100%);
            min-height: 100vh;
        }

        /* Glassmorphism Classes */
        .glass-card {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
        }

        .glass-nav {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-right: 1px solid rgba(255, 255, 255, 0.6);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.02);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(99, 102, 241, 0.3);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(99, 102, 241, 0.5);
        }

        /* Layout Responsif */
        .app-wrapper {
            position: fixed;
            inset: 0;
            z-index: 999999;
            display: flex;
            overflow: hidden;
        }

        @media (max-width: 768px) {
            .app-wrapper {
                flex-direction: column;
            }
            .sidebar-desk {
                display: none;
            }
            .bottom-nav {
                display: flex;
            }
            .main-content {
                padding-bottom: 80px;
            }
        }

        @media (min-width: 769px) {
            .bottom-nav {
                display: none;
            }
        }
    </style>
</head>
<body class="text-slate-800 antialiased">

    <!-- APP WRAPPER -->
    <div class="app-wrapper">
        
        <!-- MODAL SYSTEM UI -->
        <div id="custom-modal" class="hidden fixed inset-0 z-[9999999] flex items-center justify-center bg-slate-900/40 backdrop-blur-sm transition-all p-4">
            <div class="glass-card bg-white/90 rounded-2xl max-w-md w-full p-6 shadow-2xl border border-white transform transition-all">
                <div class="flex items-center space-x-3 mb-4">
                    <div id="modal-icon-bg" class="w-10 h-10 rounded-full flex items-center justify-center bg-brand-100 text-brand-600">
                        <i id="modal-icon" class="fas fa-info-circle text-lg"></i>
                    </div>
                    <h3 id="modal-title" class="text-lg font-bold text-slate-800">Pemberitahuan</h3>
                </div>
                <p id="modal-message" class="text-slate-600 text-sm mb-6 leading-relaxed"></p>
                <div class="flex justify-end space-x-3" id="modal-actions">
                    <button onclick="closeModal()" class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-medium text-sm transition-all shadow-md hover:shadow-brand-500/25">OK</button>
                </div>
            </div>
        </div>

        <!-- BANNER MODE PREVIEW -->
        <div id="preview-banner" class="hidden fixed top-0 left-0 right-0 z-[9999998] bg-amber-500 text-white text-xs py-1 px-4 flex justify-between items-center shadow-sm font-medium">
            <div class="flex items-center space-x-2">
                <i class="fas fa-flask"></i>
                <span><strong>Mode Preview Aktif</strong> &bull; Berjalan dengan data lokal di browser.</span>
            </div>
            <div class="flex space-x-2">
                <button onclick="quickLogin('admin')" class="bg-amber-700 hover:bg-amber-800 text-white px-2 py-0.5 rounded text-[11px] transition">Quick Admin</button>
                <button onclick="quickLogin('user')" class="bg-amber-700 hover:bg-amber-800 text-white px-2 py-0.5 rounded text-[11px] transition">Quick Staf</button>
            </div>
        </div>

        <!-- SCREEN 1: LOGIN -->
        <div id="screen-login" class="w-full h-full flex items-center justify-center p-4 bg-slate-100/50">
            <div class="glass-card rounded-3xl p-8 max-w-md w-full shadow-2xl border border-white/80 relative overflow-hidden">
                <div class="absolute -top-10 -right-10 w-40 h-40 bg-brand-500/10 rounded-full blur-2xl"></div>
                <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-indigo-500/10 rounded-full blur-2xl"></div>

                <div class="text-center mb-8 relative">
                    <div class="w-16 h-16 bg-gradient-to-tr from-brand-600 to-indigo-500 rounded-2xl mx-auto flex items-center justify-center text-white text-2xl shadow-lg shadow-brand-500/30 mb-3">
                        <i class="fas fa-envelope-open-text"></i>
                    </div>
                    <h1 class="text-2xl font-bold text-slate-800">SiSurat Digital</h1>
                    <p class="text-slate-500 text-xs mt-1">Sistem Pengarsipan Surat Masuk & Keluar</p>
                </div>

                <!-- TAB LOGIN TYPE -->
                <div class="flex bg-slate-200/60 p-1 rounded-xl mb-6 text-xs font-semibold">
                    <button id="tab-login-admin" onclick="switchLoginType('admin')" class="flex-1 py-2.5 rounded-lg text-slate-700 transition bg-white shadow-sm">Admin / Petugas</button>
                    <button id="tab-login-staf" onclick="switchLoginType('staf')" class="flex-1 py-2.5 rounded-lg text-slate-500 transition">Staf / Penerima</button>
                </div>

                <!-- FORM LOGIN -->
                <form id="form-login" onsubmit="handleLogin(event)" class="space-y-4">
                    <input type="hidden" id="login-role-type" value="admin">
                    
                    <div>
                        <label id="lbl-username" class="block text-xs font-semibold text-slate-600 mb-1">Email Auth (Admin)</label>
                        <div class="relative">
                            <i class="fas fa-user absolute left-3.5 top-3.5 text-slate-400 text-sm"></i>
                            <input type="text" id="input-username" required placeholder="admin@sisurat.id" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-sm bg-white/70">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Kata Sandi</label>
                        <div class="relative">
                            <i class="fas fa-lock absolute left-3.5 top-3.5 text-slate-400 text-sm"></i>
                            <input type="password" id="input-password" required placeholder="••••••••" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-sm bg-white/70">
                        </div>
                    </div>

                    <button type="submit" class="w-full py-3 bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-700 hover:to-indigo-700 text-white font-semibold rounded-xl text-sm shadow-lg shadow-brand-500/25 transition duration-200 mt-2 flex justify-center items-center">
                        <span id="btn-login-text">Masuk ke Sistem</span>
                    </button>
                </form>

                <div class="mt-6 text-center text-xs text-slate-400">
                    &copy; 2026 Arsip Digital &bull; Serverless Edition
                </div>
            </div>
        </div>

        <!-- SCREEN 2: MAIN DASHBOARD & APP -->
        <div id="screen-app" class="hidden flex-1 flex w-full h-full overflow-hidden">
            
            <!-- DESKTOP SIDEBAR -->
            <aside class="sidebar-desk w-64 glass-nav flex flex-col justify-between p-4 z-20">
                <div>
                    <!-- BRAND -->
                    <div class="flex items-center space-x-3 p-3 mb-6">
                        <div class="w-10 h-10 bg-brand-600 rounded-xl flex items-center justify-center text-white text-lg shadow-md">
                            <i class="fas fa-envelope-open-text"></i>
                        </div>
                        <div>
                            <h2 class="font-bold text-slate-800 text-base leading-tight">SiSurat</h2>
                            <span class="text-[10px] text-brand-600 font-medium bg-brand-50 px-2 py-0.5 rounded-full border border-brand-100">v2.5 Professional</span>
                        </div>
                    </div>

                    <!-- USER INFO BRIEF -->
                    <div class="bg-indigo-50/50 border border-indigo-100 p-3 rounded-xl mb-6 flex items-center space-x-3">
                        <div class="w-8 h-8 rounded-full bg-brand-600 text-white flex items-center justify-center font-bold text-xs" id="side-user-avatar">
                            A
                        </div>
                        <div class="overflow-hidden">
                            <p class="text-xs font-bold text-slate-800 truncate" id="side-user-name">Administrator</p>
                            <p class="text-[10px] text-slate-500 capitalize" id="side-user-role">Role: Admin Auth</p>
                        </div>
                    </div>

                    <!-- MENU LIST -->
                    <nav class="space-y-1">
                        <button onclick="navigate('dashboard')" id="nav-dashboard" class="nav-item w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition text-brand-600 bg-brand-50">
                            <i class="fas fa-chart-pie w-5 text-center"></i>
                            <span>Dashboard</span>
                        </button>
                        <button onclick="navigate('surat-masuk')" id="nav-surat-masuk" class="nav-item w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition text-slate-600 hover:bg-slate-100">
                            <i class="fas fa-inbox w-5 text-center"></i>
                            <span>Surat Masuk</span>
                        </button>
                        <button onclick="navigate('surat-keluar')" id="nav-surat-keluar" class="nav-item w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition text-slate-600 hover:bg-slate-100">
                            <i class="fas fa-paper-plane w-5 text-center"></i>
                            <span>Surat Keluar</span>
                        </button>
                        <button onclick="navigate('kelola-staf')" id="nav-kelola-staf" class="nav-item w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition text-slate-600 hover:bg-slate-100">
                            <i class="fas fa-users-cog w-5 text-center"></i>
                            <span>Kelola Staf</span>
                        </button>
                        <button onclick="navigate('laporan')" id="nav-laporan" class="nav-item w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition text-slate-600 hover:bg-slate-100">
                            <i class="fas fa-file-invoice w-5 text-center"></i>
                            <span>Laporan & Export</span>
                        </button>
                    </nav>
                </div>

                <div>
                    <button onclick="logout()" class="w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-rose-600 hover:bg-rose-50 transition">
                        <i class="fas fa-sign-out-alt w-5 text-center"></i>
                        <span>Keluar Sistem</span>
                    </button>
                </div>
            </aside>

            <!-- MAIN CONTENT AREA -->
            <main class="main-content flex-1 flex flex-col h-full overflow-y-auto">
                
                <!-- TOPBAR MOBILE & DESKTOP HEADER -->
                <header class="glass-card sticky top-0 z-10 px-6 py-4 flex items-center justify-between border-b border-white/60">
                    <div>
                        <h1 class="text-lg font-bold text-slate-800 capitalize" id="page-title">Dashboard Summary</h1>
                        <p class="text-xs text-slate-500" id="page-subtitle">Kelola dan pantau aliran surat organisasi</p>
                    </div>
                    <div class="flex items-center space-x-3">
                        <div class="text-right hidden sm:block">
                            <p class="text-xs font-bold text-slate-700" id="top-user-name">Admin</p>
                            <p class="text-[10px] text-slate-400" id="top-current-date">--/--/----</p>
                        </div>
                        <button onclick="logout()" class="md:hidden text-rose-600 p-2 text-sm">
                            <i class="fas fa-power-off"></i>
                        </button>
                    </div>
                </header>

                <!-- VIEW 1: DASHBOARD -->
                <section id="view-dashboard" class="p-6 space-y-6">
                    <!-- STATS CARDS -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div class="glass-card rounded-2xl p-4 flex items-center space-x-4 border-l-4 border-indigo-500">
                            <div class="w-12 h-12 bg-indigo-100 text-indigo-600 rounded-xl flex items-center justify-center text-xl">
                                <i class="fas fa-inbox"></i>
                            </div>
                            <div>
                                <p class="text-xs text-slate-500 font-medium">Surat Masuk</p>
                                <h3 class="text-xl font-bold text-slate-800" id="stat-surat-masuk">0</h3>
                            </div>
                        </div>

                        <div class="glass-card rounded-2xl p-4 flex items-center space-x-4 border-l-4 border-emerald-500">
                            <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center text-xl">
                                <i class="fas fa-paper-plane"></i>
                            </div>
                            <div>
                                <p class="text-xs text-slate-500 font-medium">Surat Keluar</p>
                                <h3 class="text-xl font-bold text-slate-800" id="stat-surat-keluar">0</h3>
                            </div>
                        </div>

                        <div class="glass-card rounded-2xl p-4 flex items-center space-x-4 border-l-4 border-amber-500">
                            <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-xl flex items-center justify-center text-xl">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                            <div>
                                <p class="text-xs text-slate-500 font-medium">Bulan Ini</p>
                                <h3 class="text-xl font-bold text-slate-800" id="stat-bulan-ini">0</h3>
                            </div>
                        </div>

                        <div class="glass-card rounded-2xl p-4 flex items-center space-x-4 border-l-4 border-purple-500">
                            <div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-xl flex items-center justify-center text-xl">
                                <i class="fas fa-users"></i>
                            </div>
                            <div>
                                <p class="text-xs text-slate-500 font-medium">Total Staf</p>
                                <h3 class="text-xl font-bold text-slate-800" id="stat-total-staf">0</h3>
                            </div>
                        </div>
                    </div>

                    <!-- CHART & RECENT -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <div class="glass-card lg:col-span-2 rounded-2xl p-5">
                            <h3 class="text-sm font-bold text-slate-800 mb-4 flex items-center justify-between">
                                <span>Statistik Pengarsipan Surat</span>
                                <span class="text-xs text-slate-400 font-normal">Tahun 2026</span>
                            </h3>
                            <div class="h-64">
                                <canvas id="chart-surat"></canvas>
                            </div>
                        </div>

                        <div class="glass-card rounded-2xl p-5 flex flex-col justify-between">
                            <div>
                                <h3 class="text-sm font-bold text-slate-800 mb-4">Aksi Cepat</h3>
                                <div class="space-y-3">
                                    <button onclick="openModalSuratMasuk()" class="w-full p-3 rounded-xl bg-gradient-to-r from-brand-600 to-indigo-600 text-white font-medium text-xs flex items-center justify-between hover:opacity-95 transition shadow-md">
                                        <span class="flex items-center space-x-2">
                                            <i class="fas fa-plus-circle"></i>
                                            <span>Tambah Surat Masuk</span>
                                        </span>
                                        <i class="fas fa-chevron-right text-[10px]"></i>
                                    </button>
                                    <button onclick="openModalSuratKeluar()" class="w-full p-3 rounded-xl bg-slate-800 text-white font-medium text-xs flex items-center justify-between hover:bg-slate-900 transition shadow-md">
                                        <span class="flex items-center space-x-2">
                                            <i class="fas fa-paper-plane"></i>
                                            <span>Buat Surat Keluar</span>
                                        </span>
                                        <i class="fas fa-chevron-right text-[10px]"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="mt-6 pt-4 border-t border-slate-200/60">
                                <div class="flex items-center space-x-3 text-xs text-slate-500">
                                    <i class="fas fa-shield-alt text-brand-600 text-base"></i>
                                    <p>Seluruh dokumen tersimpan aman dalam media penyimpanan terenkripsi Supabase.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- VIEW 2: SURAT MASUK -->
                <section id="view-surat-masuk" class="hidden p-6 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div class="relative flex-1 max-w-md">
                            <i class="fas fa-search absolute left-3.5 top-3.5 text-slate-400 text-xs"></i>
                            <input type="text" id="search-surat-masuk" oninput="renderSuratMasuk()" placeholder="Cari no. surat, pengirim, atau perihal..." class="w-full pl-9 pr-4 py-2 rounded-xl border border-slate-200 text-xs bg-white/70 focus:outline-none focus:ring-2 focus:ring-brand-500">
                        </div>
                        <button onclick="openModalSuratMasuk()" class="px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-xl flex items-center justify-center space-x-2 transition shadow-md">
                            <i class="fas fa-plus"></i>
                            <span>Catat Surat Masuk</span>
                        </button>
                    </div>

                    <!-- TABLE SURAT MASUK -->
                    <div class="glass-card rounded-2xl overflow-hidden border border-white">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs text-slate-600">
                                <thead class="bg-slate-100/80 text-slate-700 font-semibold uppercase text-[10px] tracking-wider border-b border-slate-200/60">
                                    <tr>
                                        <th class="p-3.5">No. Agenda</th>
                                        <th class="p-3.5">No & Tgl Surat</th>
                                        <th class="p-3.5">Pengirim</th>
                                        <th class="p-3.5">Perihal & Disposisi</th>
                                        <th class="p-3.5">Berkas</th>
                                        <th class="p-3.5 text-center">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="table-surat-masuk-body" class="divide-y divide-slate-100">
                                    <!-- Dynamic content -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- VIEW 3: SURAT KELUAR -->
                <section id="view-surat-keluar" class="hidden p-6 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div class="relative flex-1 max-w-md">
                            <i class="fas fa-search absolute left-3.5 top-3.5 text-slate-400 text-xs"></i>
                            <input type="text" id="search-surat-keluar" oninput="renderSuratKeluar()" placeholder="Cari no. surat, penerima, atau perihal..." class="w-full pl-9 pr-4 py-2 rounded-xl border border-slate-200 text-xs bg-white/70 focus:outline-none focus:ring-2 focus:ring-brand-500">
                        </div>
                        <button onclick="openModalSuratKeluar()" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-xl flex items-center justify-center space-x-2 transition shadow-md">
                            <i class="fas fa-plus"></i>
                            <span>Catat Surat Keluar</span>
                        </button>
                    </div>

                    <!-- TABLE SURAT KELUAR -->
                    <div class="glass-card rounded-2xl overflow-hidden border border-white">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs text-slate-600">
                                <thead class="bg-slate-100/80 text-slate-700 font-semibold uppercase text-[10px] tracking-wider border-b border-slate-200/60">
                                    <tr>
                                        <th class="p-3.5">No. Agenda</th>
                                        <th class="p-3.5">No & Tgl Surat</th>
                                        <th class="p-3.5">Tujuan / Penerima</th>
                                        <th class="p-3.5">Perihal & Pengolah</th>
                                        <th class="p-3.5">Berkas</th>
                                        <th class="p-3.5 text-center">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="table-surat-keluar-body" class="divide-y divide-slate-100">
                                    <!-- Dynamic content -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- VIEW 4: KELOLA STAF -->
                <section id="view-kelola-staf" class="hidden p-6 space-y-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <h3 class="text-sm font-bold text-slate-800">Daftar Akun Staf / User Tabel</h3>
                            <p class="text-xs text-slate-500">User yang login via kredensial NIP/Username</p>
                        </div>
                        <button onclick="openModalStaf()" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-xl flex items-center space-x-2 shadow-md transition">
                            <i class="fas fa-user-plus"></i>
                            <span>Tambah Staf Baru</span>
                        </button>
                    </div>

                    <div class="glass-card rounded-2xl overflow-hidden border border-white">
                        <table class="w-full text-left text-xs text-slate-600">
                            <thead class="bg-slate-100/80 text-slate-700 font-semibold uppercase text-[10px] tracking-wider border-b border-slate-200/60">
                                <tr>
                                    <th class="p-3.5">NIP / Username</th>
                                    <th class="p-3.5">Nama Lengkap</th>
                                    <th class="p-3.5">Jabatan</th>
                                    <th class="p-3.5 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="table-staf-body" class="divide-y divide-slate-100">
                                <!-- Dynamic content -->
                            </tbody>
                        </table>
                    </div>
                </section>

                <!-- VIEW 5: LAPORAN -->
                <section id="view-laporan" class="hidden p-6 space-y-6">
                    <div class="glass-card p-5 rounded-2xl space-y-4">
                        <h3 class="text-sm font-bold text-slate-800">Filter Rekapitulasi Laporan</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
