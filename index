        // ==========================================
        // 10. LAPORAN & EXPORT EXCEL/CSV
        // ==========================================
        async function exportCSV() {
            const jenis = document.getElementById('filter-laporan-jenis').value;
            let rows = [];

            if (jenis === 'semua' || jenis === 'masuk') {
                let sm = [];
                if (IS_PREVIEW) {
                    sm = localData.surat_masuk;
                } else {
                    if (!supabase) supabase = initSupabaseClient();
                    sm = (await supabase.from('surat_masuk').select('*')).data || [];
                }
                sm.forEach(item => {
                    rows.push({
                        Jenis: 'SURAT MASUK',
                        NoAgenda: item.no_agenda,
                        NoSurat: item.no_surat,
                        Tanggal: item.tgl_surat,
                        Pengirim_Penerima: item.pengirim,
                        Perihal: item.perihal,
                        Disposisi_Pengolah: item.disposisi
                    });
                });
            }

            if (jenis === 'semua' || jenis === 'keluar') {
                let sk = [];
                if (IS_PREVIEW) {
                    sk = localData.surat_keluar;
                } else {
                    if (!supabase) supabase = initSupabaseClient();
                    sk = (await supabase.from('surat_keluar').select('*')).data || [];
                }
                sk.forEach(item => {
                    rows.push({
                        Jenis: 'SURAT KELUAR',
                        NoAgenda: item.no_agenda,
                        NoSurat: item.no_surat,
                        Tanggal: item.tgl_surat,
                        Pengirim_Penerima: item.penerima,
                        Perihal: item.perihal,
                        Disposisi_Pengolah: item.pengolah
                    });
                });
            }

            if (rows.length === 0) {
                showModal("Export Gagal", "Tidak ada data untuk diexport", "fas fa-exclamation-triangle", "bg-amber-100 text-amber-600");
                return;
            }

            let csvContent = "data:text/csv;charset=utf-8,";
            csvContent += Object.keys(rows[0]).join(",") + "\n";

            rows.forEach(row => {
                csvContent += Object.values(row).map(v => `"${v || ''}"`).join(",") + "\n";
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Rekap_Surat_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
